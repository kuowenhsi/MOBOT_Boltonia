# Read the data
fst <- read.table("./Data/Boltonia_decurrens_100kb0.8.fst.summary", header = FALSE, sep = "\t")
colnames(fst) <- c("POP1", "POP2", "FST")
# Get list of all unique populations
pops <- sort(unique(c(fst$POP1, fst$POP2)))
# Initialize square matrix with NA
fst_matrix <- matrix(NA, nrow = length(pops), ncol = length(pops),
dimnames = list(pops, pops))
# Fill in the matrix
for (i in 1:nrow(fst)) {
p1 <- fst$POP1[i]
p2 <- fst$POP2[i]
val <- fst$FST[i]
fst_matrix[p1, p2] <- val
fst_matrix[p2, p1] <- val  # Symmetric
}
# View the matrix
print(fst_matrix)
fst <- melt(fst_matrix, varnames = c("POP1", "POP2"), value.name = "FST")
#makes the order by latitude (did it manually)
custom_order <- c("saint_clair", "madison", "alton", "jersey", "scott", "morgan", "cass", "schuyler", "frederick", "fulton2", "fulton1", "fulton3", "peoria", "tazewell", "woodford", "marshal", "hennepin")  # example
fst$POP1 <- factor(fst$POP1, levels = custom_order)
fst$POP2 <- factor(fst$POP2, levels = rev(custom_order))
#FST Heatmap
Fst_heatmap <- ggplot(fst, aes(x = POP1, y = POP2, fill = FST)) +
geom_tile(color = "white", linewidth = 0.5) +
geom_text(aes(label = ifelse(is.na(FST), "", sprintf("%.2f", FST))), size = 3, color = "black") +
scale_fill_gradient(low = "green", high = "red", na.value = "grey90",
name = expression(italic(F)[ST])) +
scale_x_discrete(position = "top") +
coord_fixed() +
theme_minimal(base_size = 14) +
theme(
axis.text.x = element_text(angle = 45, hjust = 0, margin = margin(b = 10)),
axis.text.y = element_text(size = 12),
panel.grid = element_blank(),
legend.position = "right",
legend.title = element_text(face = "italic", size = 12),
plot.title = element_text(size = 16, face = "bold", hjust = 0.5),
plot.margin = margin(10, 10, 10, 10)
) +
labs(title = "Pairwise Fst Heatmap", x = NULL, y = NULL)
ggsave("./Figures/Fst_heatmap.png", plot = Fst_heatmap,
width = 8, height = 6, units = "in", dpi = 300, bg = "white")
#adds distance between each population to fst
distance <- read.csv("./Data/pairwise_river_distances.csv", header = TRUE) |>
rename(distance_m = Total_Length) |>
separate(Name, into = c("POP1", "POP2"), sep = "-") |>
select(POP1, POP2, distance_m)
setdiff(fst$POP1, distance$POP1)
setdiff(distance$POP1, fst$POP1)
setdiff(fst$POP2, distance$POP2)
setdiff(distance$POP2, fst$POP2)
#adds distance between each population to fst
distance <- read.csv("./Data/pairwise_river_distances.csv", header = TRUE) |>
rename(distance_m = Total_Length) |>
separate(Name, into = c("POP1", "POP2"), sep = " - ") |>
select(POP1, POP2, distance_m)
fst <- fst |>
left_join(distance, by = c("POP1", "POP2"))
##Mantel test##---------------------------------------------------
fst <- fst |>                        # <-- your original long data frame
mutate(across(c(POP1, POP2), ~ trimws(as.character(.x)))) |>  # drop spaces, make char
filter(POP1 != POP2) |>            # keep only true pairwise rows
rowwise() |>                       # create a canonical order for each pair
mutate(pair_id = paste(sort(c(POP1, POP2)), collapse = "|")) |>
ungroup() |>
distinct(pair_id, .keep_all = TRUE) # keep only ONE row per unordered pair
## 1.  All unique population names, one definitive order
pops <- sort(unique(c(fst$POP1, fst$POP2)))   # alphabetical keeps life simple
## 2.  Empty square matrix with *matching* dimnames
geo_matrix <- matrix(NA_real_,
nrow = length(pops), ncol = length(pops),
dimnames = list(pops, pops))
## 3.  Fill it, now guaranteed to match
for (i in seq_len(nrow(fst))) {
p1   <- fst$POP1[i]
p2   <- fst$POP2[i]
dist <- fst$distance_m[i]
geo_matrix[p1, p2] <- dist
geo_matrix[p2, p1] <- dist          # symmetry
}
#convert to distance matrix, then run mantel
dist_var_mat <- as.dist(geo_matrix)
dist_fst_mat <- as.dist(fst_matrix)
mantel_result <- mantel(dist_var_mat, dist_fst_mat, method = "pearson", permutations = 999)
#mantel results
mantel_r <- round(mantel_result$statistic, 3)
mantel_p <- mantel_result$signif
## --- Isolation‑by‑distance Mantel result ----
mantel_r_ibd <- round(mantel_result$statistic, 3)
mantel_p_ibd <- mantel_result$signif
# 1️⃣  start the results list with the IBD entry
mantel_results <- list(
tibble(
variable   = "distance_m",
pretty_var = "Distance (km)",
mantel_r   = mantel_r_ibd,
mantel_p   = mantel_p_ibd
)
)
#meters to KM for plotting
fst <- fst |>
mutate(distance_m = distance_m / 1000)
#creates plot for IBD
dist_fst <- ggplot(fst, aes(distance_m, FST)) +
geom_point() +
geom_smooth(aes(group = 1), method = lm) +
labs(
title = "Isolation by River Distance",
subtitle = paste0("Mantel R = ", mantel_r, ", p = ", mantel_p),
x = "Distance (km)",
y = "Fst",
) +
theme_minimal(base_size = 14) +
theme(
legend.position = "top",
legend.title = element_text(face = "bold"),
plot.title = element_text(face = "bold", size = 18),
plot.subtitle = element_text(size = 12, color = "grey40")
)
print(dist_fst)
ggsave("./Figures/isolation_riverdistance_plot.png",
width = 8, height = 6, units = "in", dpi = 300, bg = "white")
####creates isolation by climate variables
#reads in climate data and population ids, merges them
climate_data <- read.csv("./Data/Boltonia_buf_climate_data_20250421.csv")
pop_id <- read.csv("./Data/population_id.csv", stringsAsFactors = FALSE) |>
select(-Pop)
pop_id <- rename(pop_id, Sample_Name = IID)
pop_id <- pop_id %>%
mutate(Sample_Name = str_c("Boltonia_", str_pad(as.character(Sample_Name), width = 3, pad = "0")))
pop_id <- pop_id |>
merge(climate_data, by = "Sample_Name", all.x = TRUE) |>
select(-Adapted_Longitude, -Adapted_Latitude)
#gets the mode climate statistic for each county (for Fulton and Tazewell this matters)
climate_by_county <- pop_id |>
pivot_longer(cols = -c(1, 2, 3), names_to = "Variable", values_to = "Value") |>
group_by(Sample_Group, Variable, Value) |>
tally() |>
arrange(Sample_Group, Variable, desc(n)) |>
slice_head(n = 1) |>
select(Sample_Group, Variable, Value) |>
pivot_wider(names_from = Variable, values_from = Value)
#creates this most common climate data for POP1 and POP2 (just with those labels)
climate_by_countyPOP1 <- climate_by_county |>
rename_with(~ paste0(.x, "_POP1"), .cols = -Sample_Group)
climate_by_countyPOP1 <- climate_by_countyPOP1 |>
rename(POP1 = Sample_Group)
climate_by_countyPOP2 <- climate_by_county |>
rename_with(~ paste0(.x, "_POP2"), .cols = -Sample_Group)
climate_by_countyPOP2 <- climate_by_countyPOP2 |>
rename(POP2 = Sample_Group)
#adds climate data to fst and removes distance calculations we used earlier
fst <- merge(fst, climate_by_countyPOP1, by = "POP1", all.x = TRUE)
fst <- merge(fst, climate_by_countyPOP2, by = "POP2", all.x = TRUE)
#finds the difference between every variable pair and takes the abs
fst <- fst |>
mutate(
!!!map(
setNames(grep("_POP1$", names(fst), value = TRUE),
nm = sub("_POP1$", "_diff", grep("_POP1$", names(fst), value = TRUE))),
~ {
col1 <- .x
col2 <- sub("_POP1$", "_POP2", col1)
abs(as.numeric(fst[[col1]]) - as.numeric(fst[[col2]]))
}
)
)
#list of all the variables
diff_vars <- grep("_diff$", names(fst), value = TRUE)
#do the following for the mantel test
fst <- fst |>                         # <-- your original long data frame
mutate(across(c(POP1, POP2), ~ trimws(as.character(.x)))) |>   # drop spaces, make char
filter(POP1 != POP2) |>            # keep only true pairwise rows
rowwise() |>                        # create a canonical order for each pair
mutate(pair_id = paste(sort(c(POP1, POP2)), collapse = "|")) |>
ungroup() |>
distinct(pair_id, .keep_all = TRUE) # keep only ONE row per unordered pair
## 1.  All unique population names, one definitive order
pops <- sort(unique(c(fst$POP1, fst$POP2)))   # alphabetical keeps life simple
# Loop through each variable
for (var in diff_vars) {
# Clean up the variable name for display
pretty_var <- str_remove(var, "^[^_]+_[^_]+_")
## 1. Create empty square matrix with matching dimnames
var_matrix <- matrix(NA_real_,
nrow = length(pops), ncol = length(pops),
dimnames = list(pops, pops))
## 2. Fill the matrix symmetrically
for (i in seq_len(nrow(fst))) {
p1   <- fst$POP1[i]
p2   <- fst$POP2[i]
dist <- fst[[var]][i]
var_matrix[p1, p2] <- dist
var_matrix[p2, p1] <- dist
}
# 3. Convert to distance matrices and run Mantel test
var_mat <- as.dist(var_matrix)
fst_mat <- as.dist(fst_matrix)
mantel_result <- vegan::mantel(var_mat, fst_mat, method = "pearson", permutations = 999)
# 4. Extract Mantel statistics
mantel_r <- round(mantel_result$statistic, 3)
mantel_p <- mantel_result$signif
# 5. Store Mantel results
mantel_results[[length(mantel_results) + 1]] <- tibble(
variable = var,
pretty_var = pretty_var,
mantel_r = mantel_r,
mantel_p = mantel_p
)
# 6. Build the plot
dist_fst <- ggplot(fst, aes(x = .data[[var]], y = FST)) +
geom_point() +
geom_smooth(method = "lm", se = TRUE) +
labs(
title = paste("Isolation by", pretty_var),
subtitle = paste0("Mantel R = ", mantel_r, ", p = ", mantel_p),
x = pretty_var,
y = "FST"
) +
theme_minimal(base_size = 14) +
theme(
legend.position = "top",
legend.title    = element_text(face = "bold"),
plot.title      = element_text(face = "bold", size = 18),
plot.subtitle   = element_text(size = 12, color = "grey40")
)
# 7. Save the plot
ggsave(
filename = paste0("./Figures/isolation_by_", pretty_var, ".png"),
plot = dist_fst,
width = 8,
height = 6,
units = "in",
dpi = 300,
bg = "white"
)
}
# Combine results into a data frame
mantel_results_df <- bind_rows(mantel_results) |>
as.data.frame() |>
mutate(pretty_var = gsub("_diff$", "", pretty_var),
pretty_var = reorder(pretty_var, mantel_r))
mantel_barplot <- ggplot(mantel_results_df, aes(x = pretty_var, y = mantel_r)) +
geom_bar(stat = "identity", fill = "#2c7fb8") +               # nicer bar color
coord_flip() +                                                # horizontal bars (often easier to read)
theme_minimal() +                                             # clean theme
labs(
title = "Mantel r by Variable",
x = "Variable",
y = "Mantel r"
) +
geom_text(aes(label = round(mantel_r, 2)), hjust = -0.2, size = 4) +
expand_limits(y = max(mantel_results_df$mantel_r) * 1.1) +
theme(
axis.text = element_text(size = 9),
axis.title = element_text(size = 14, face = "bold"),
plot.title = element_text(size = 16, face = "bold", hjust = 0.5)
)
ggsave("./Figures/mantel_r_plot.png",
width = 10, height = 8, units = "in", dpi = 300, bg = "white")
