select(-1) %>%
filter(str_starts(Content, "Unkn"))%>%
group_by(Sample)%>%
summarize(SQ_mean = mean(SQ))%>%
drop_na()%>%
arrange(Sample)%>%
mutate(Dilution_factor = 40000, full_length = c(379, 350, 538, 480, 574, 500, 589, 546))%>%
mutate(adj_nM = SQ_mean*399/full_length*Dilution_factor/1000)%>%
mutate(Submission_name = c("Doraemon"), Expected_yield = c(16, 23, 471, 70, 8*16, 20, 134, 77), Flowcell_yield = 1000)%>%
mutate(Dilution_again = c(5,5,1,1,5,5,5,5), original_nM = adj_nM)%>%
mutate(adj_nM = original_nM/Dilution_again)%>%
mutate(Total_expected_yield = sum(Expected_yield))%>%
ungroup%>%
mutate(inquery = Expected_yield / adj_nM) %>%
mutate(adj_inquery = round(inquery*100/sum(inquery), digits = 1))%>%
mutate(Pooled_conc = sum(adj_nM * adj_inquery)/100)%>%
mutate(total_yield = mean(Flowcell_yield)* Expected_yield/sum(Expected_yield))
